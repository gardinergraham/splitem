{
  "expo": {
    "name": "Splitem",
    "slug": "splitem",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8EAA2"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geckostudios.splitem",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Splitem saves your character image to your photo library when you tap the camera button."
      }
    },
    "android": {
      "package": "com.geckostudios.splitem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-media-library"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
