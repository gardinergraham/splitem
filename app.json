{
  "expo": {
    "name": "Splitem",
    "slug": "split-em",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8EAA2"
    },
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geckostudios.splitem",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Splitem saves your character image to your photo library when you tap the camera button.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.geckostudios.splitem",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Splitem saves your character image to your photo library when you tap the camera button.",
          "granularPermissions": []
        }
      ],
      "./plugins/remove-android-media-permissions"
    ],
    "extra": {
      "eas": {
        "projectId": "8a7d7920-dea6-4c7f-8521-13224de17615"
      }
    },
    "owner": "slayer2saint"
  }
}
